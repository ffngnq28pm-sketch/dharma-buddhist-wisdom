{
  "expo": {
    "name": "Dharma — ☸ Dharma",
    "slug": "dharma-buddhist-wisdom",
    "version": "1.0.0",
    "description": "Sagesse bouddhiste au quotidien — citations, mala, calendrier lunaire et méditations.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dharma",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#080C09"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dharma.buddhistwisdom",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "audio"
        ],
        "NSMicrophoneUsageDescription": "Dharma n'utilise pas le microphone.",
        "CFBundleDisplayName": "Dharma"
      }
    },
    "android": {
      "package": "com.dharma.buddhistwisdom",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#080C09"
      },
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#080C09",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ca23aa36-ecde-47e1-a153-25176bd6dc99"
      }
    },
    "owner": "charif759491",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ca23aa36-ecde-47e1-a153-25176bd6dc99"
    }
  }
}